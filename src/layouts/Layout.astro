---
import '../styles/main.scss';
import { siteConfig } from '../config';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Cheul Young Park', description = 'Personal website of Cheul Young Park' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.googleAnalytics}`}></script>
    <script is:inline define:vars={{ googleAnalytics: siteConfig.googleAnalytics }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', googleAnalytics);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
